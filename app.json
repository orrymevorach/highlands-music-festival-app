{
  "expo": {
    "name": "HighlandsMusicFestival",
    "slug": "HighlandsMusicFestival",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo-No-Bkgd-min.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Logo-No-Bkgd-min.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.highlandsmusicfestival.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.highlandsmusicfestival.app"
    },
    "web": {
      "favicon": "./assets/Logo-No-Bkgd-min.png"
    },
    "extra": {
      "eas": {
        "projectId": "c0c22e52-b015-4751-b312-dd4e78fd5236"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ]
  }
}
